FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY phase3_rag/requirements.txt phase3_rag/
COPY phase1_ingestion/requirements.txt phase1_ingestion/
COPY phase2_models/requirements.txt phase2_models/

# Install requirements
RUN pip install --no-cache-dir -r phase3_rag/requirements.txt
RUN pip install --no-cache-dir -r phase1_ingestion/requirements.txt
RUN pip install --no-cache-dir -r phase2_models/requirements.txt

# Copy code
COPY . .

# Set environment variables
ENV USE_LOCAL_LLM=false
ENV DB_HOST=${DB_HOST}
ENV DB_PORT=3306
ENV DB_NAME=fraud_db
ENV DB_USER=${DB_USER}
ENV DB_PASSWORD=${DB_PASSWORD}

# Expose ports
EXPOSE 8002
EXPOSE 8501

# Start both services
RUN echo '#!/bin/bash\n\
cd /app && \\\n\
# Start API in background\n\
cd /app/phase3_rag && python fast_api.py &\n\
# Start UI\n\
cd /app/phase3_rag && streamlit run chat_ui.py --server.port=8501 --server.address=0.0.0.0\n\
' > /app/start.sh && chmod +x /app/start.sh

CMD ["/app/start.sh"]